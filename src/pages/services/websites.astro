---
import type { CollectionEntry } from 'astro:content'
import Base from '../../layouts/base.astro'
import FeaturesOverviewLight from '../../assets/svg/rosely/undraw_features_overview-light.svg'
import FeaturesOverviewDark from '../../assets/svg/rosely/undraw_features_overview-dark.svg'
import socialImage from '../../assets/social/features_overview.png'
import { Image } from 'astro:assets'
import HelloThamLight from '../../assets/apps/hellotham-light.png'
import HelloThamDark from '../../assets/apps/hellotham-dark.png'
import HelloAstroLight from '../../assets/apps/helloastro-light.png'
import HelloAstroDark from '../../assets/apps/helloastro-dark.png'
import SpotliteShot from '../../assets/apps/spotlite.png'
import RoselySystem from '../../assets/apps/rosely-system.svg'

const baseUrl = import.meta.env.BASE_URL

const frontmatter: CollectionEntry<'page'>['data'] = {
  title: 'Websites and Content Platforms',
  description: 'Fast, accessible, content-driven sites on modern serverless architecture',
  socialImage: socialImage
}

const capabilities = [
  {
    name: 'Corporate and content sites',
    body: 'Static and server-rendered Astro sites with Tailwind — marketing pages, blogs, documentation and portfolios that load quickly and stay fast as they grow.'
  },
  {
    name: 'Design systems',
    body: 'Token-based design language in light and dark mode, grounded in our own Rosely design system — so every page, chart and component reads as one voice.'
  },
  {
    name: 'Content engineering',
    body: 'Markdown, MDX and Markdoc pipelines with local full-text search, RSS, structured data, Open Graph and accessibility built in from the first commit.'
  },
  {
    name: 'Serverless delivery',
    body: 'Deployed to content delivery networks with automated publishing pipelines, sitemaps and search-engine settings handled, and performance independently verified — with no servers to maintain.'
  }
]

interface Build {
  label: string
  title: string
  body: string
  href: string
  shotLight?: ImageMetadata
  shotDark?: ImageMetadata
  diagram?: ImageMetadata
}

const builds: Build[] = [
  {
    label: 'This site',
    title: 'hellotham.com',
    body: 'Our corporate site — Astro 7, Tailwind CSS 4, Pagefind search, dynamic future-dated publishing and the Rosely design language you are reading now.',
    href: 'https://hellotham.com',
    shotLight: HelloThamLight,
    shotDark: HelloThamDark
  },
  {
    label: 'Template',
    title: 'Hello Astro',
    body: 'Our open-source, multi-purpose Astro starter — corporate pages, blog, documentation and galleries in TypeScript and Tailwind, with search and SEO built in. This site is built on it.',
    href: 'https://hellotham.com/hello-astro/',
    shotLight: HelloAstroLight,
    shotDark: HelloAstroDark
  },
  {
    label: 'Template',
    title: 'Spotlite',
    body: 'An open-source personal site template built with Astro, UnoCSS and Iconify — professional timeline, portfolio, articles and CV download, in light and dark. We publish the template on GitHub and run it ourselves: it is the personal site and CV of our founder, Chris Tham.',
    href: 'https://hellotham.com/spotlite/',
    shotLight: SpotliteShot
  },
  {
    label: 'Design system',
    title: 'Rosely',
    body: 'The constraint-based colour palette and design system behind our work, documented and published as its own site.',
    href: 'https://rosely.hellotham.com',
    diagram: RoselySystem
  }
]
---

<Base {frontmatter}>
  <div class="dark:border-ink-soft border-line dark:bg-ink border-b bg-white">
    <div class="mx-auto grid max-w-7xl lg:grid-cols-12">
      <div class="px-6 py-14 sm:px-10 lg:col-span-7 lg:px-14 lg:py-18">
        <p class="dark:text-aqua text-mulberry mb-5 font-mono text-xs tracking-widest uppercase">
          Services · 07 · New practice
        </p>
        <h1
          class="text-ink dark:text-cream font-serif text-4xl leading-none font-medium tracking-tight sm:text-5xl"
        >
          Websites and Content Platforms.
        </h1>
        <p class="text-slate dark:text-fog mt-6 max-w-xl text-lg leading-relaxed">
          Fast, accessible, content-driven sites on a modern serverless stack — designed, written
          and delivered as one accountable engagement.
        </p>
      </div>
      <div
        class="dark:border-ink-soft dark:bg-plum border-line bg-quartz flex items-center justify-center border-t p-8 sm:p-10 lg:col-span-5 lg:border-t-0 lg:border-l"
      >
        <img
          src={FeaturesOverviewLight.src}
          width={FeaturesOverviewLight.width}
          height={FeaturesOverviewLight.height}
          alt=""
          class="max-h-64 w-full object-contain dark:hidden"
        />
        <img
          src={FeaturesOverviewDark.src}
          width={FeaturesOverviewDark.width}
          height={FeaturesOverviewDark.height}
          alt=""
          class="hidden max-h-64 w-full object-contain dark:block"
        />
      </div>
    </div>
  </div>

  <div class="dark:bg-ink bg-white">
    <div class="mx-auto max-w-7xl px-6 py-14 sm:px-10 lg:px-14 lg:py-16">
      <h2 class="text-ink dark:text-cream mb-8 font-serif text-3xl font-medium">What we deliver</h2>
      <div class="grid gap-x-12 gap-y-8 md:grid-cols-2">
        {
          capabilities.map((c) => (
            <div class="dark:border-ink-soft border-line border-t pt-5">
              <h3 class="text-ink dark:text-cream font-serif text-2xl font-medium">{c.name}</h3>
              <p class="text-slate dark:text-fog mt-2 text-base leading-relaxed">{c.body}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="dark:border-ink-soft dark:bg-ink-deep border-line bg-cream border-t">
    <div class="mx-auto max-w-7xl px-6 py-14 sm:px-10 lg:px-14 lg:py-16">
      <div class="mb-8 flex flex-wrap items-baseline justify-between gap-4">
        <h2 class="text-ink dark:text-cream font-serif text-3xl font-medium">Built in the open</h2>
        <a
          href={baseUrl + 'apps'}
          class="dark:text-quartz text-ink hover:text-mulberry font-mono text-xs tracking-widest uppercase dark:hover:text-white"
        >
          Apps &amp; templates →
        </a>
      </div>
      {
        builds.map((b) => (
          <div class="dark:border-ink-soft border-line grid items-center gap-6 border-t py-8 lg:grid-cols-12 lg:gap-12">
            <div class="dark:text-aqua text-slate font-mono text-xs leading-relaxed uppercase lg:col-span-2">
              {b.label}
            </div>
            <div class="lg:col-span-6">
              <div class="text-ink dark:text-cream mb-1.5 font-serif text-xl font-medium">
                {b.title}
              </div>
              <div class="dark:text-fog text-slate text-base leading-relaxed">{b.body}</div>
              <a
                href={b.href}
                rel="noopener noreferrer"
                target="_blank"
                class="dark:text-quartz text-ink hover:text-mulberry mt-3 inline-block font-mono text-xs tracking-widest uppercase dark:hover:text-white"
              >
                Visit site →
              </a>
            </div>
            <div class="lg:col-span-4">
              {b.diagram ? (
                <img
                  src={b.diagram.src}
                  width={b.diagram.width}
                  height={b.diagram.height}
                  alt={b.title + ' overview diagram'}
                  class="border-line dark:border-ink-soft w-full border bg-white object-contain p-3"
                  loading="lazy"
                />
              ) : (
                <>
                  <Image
                    src={b.shotLight!}
                    alt={b.title + ' screenshot'}
                    width={720}
                    class="border-line dark:border-ink-soft w-full border object-cover dark:hidden"
                  />
                  <Image
                    src={b.shotDark ?? b.shotLight!}
                    alt=""
                    width={720}
                    class="dark:border-ink-soft hidden w-full border object-cover dark:block"
                  />
                </>
              )}
            </div>
          </div>
        ))
      }
    </div>
  </div>

  <div class="dark:bg-plum bg-ink">
    <div
      class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-6 py-14 sm:px-10 lg:flex-row lg:items-center lg:gap-12 lg:px-14"
    >
      <div>
        <h2 class="text-cream font-serif text-3xl font-medium">Need a site that lasts?</h2>
        <p class="text-fog dark:text-plum-mist mt-3 max-w-lg text-base leading-relaxed">
          We design, build and hand over content platforms your team can actually run — or we run
          them with you.
        </p>
      </div>
      <a
        href={baseUrl + 'contact'}
        class="bg-quartz text-ink rounded px-9 py-4 text-base font-semibold whitespace-nowrap hover:bg-white"
      >
        Contact us
      </a>
    </div>
  </div>
</Base>
