---
import TeamLight from '../assets/svg/rosely/undraw_team_page-light.svg'
import TeamDark from '../assets/svg/rosely/undraw_team_page-dark.svg'
import PartnersLight from '../assets/svg/rosely/undraw_features_overview-light.svg'
import PartnersDark from '../assets/svg/rosely/undraw_features_overview-dark.svg'
import WorkLight from '../assets/svg/rosely/undraw_all_the_data-light.svg'
import WorkDark from '../assets/svg/rosely/undraw_all_the_data-dark.svg'
import AppsLight from '../assets/svg/rosely/undraw_apps-light.svg'
import AppsDark from '../assets/svg/rosely/undraw_apps-dark.svg'

const baseUrl = import.meta.env.BASE_URL

const callouts = [
  {
    name: 'People',
    description: 'The consultants who do the work, and the experience they bring.',
    light: TeamLight,
    dark: TeamDark,
    href: 'consultants'
  },
  {
    name: 'Partners',
    description: 'AWS, Microsoft, Domo and Netlify — the platforms we build and advise on.',
    light: PartnersLight,
    dark: PartnersDark,
    href: 'partners'
  },
  {
    name: 'Achievements',
    description: 'Recent engagements delivered for enterprise and government clients.',
    light: WorkLight,
    dark: WorkDark,
    href: 'work'
  },
  {
    name: 'Apps',
    description: 'HelloNotes and FinvestLens — the native apps we design and publish ourselves.',
    light: AppsLight,
    dark: AppsDark,
    href: 'apps'
  }
]
---

<div class="dark:border-ink-soft dark:bg-ink-deep border-line bg-cream border-t border-b">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:px-10 lg:px-14 lg:py-18">
    <h2 class="text-ink dark:text-cream mb-8 font-serif text-3xl font-medium lg:text-4xl">
      Find out more
    </h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-4">
      {
        callouts.map((c) => (
          <a href={baseUrl + c.href} class="group block">
            <div class="dark:border-ink-soft dark:bg-plum border-line flex h-56 items-center justify-center border bg-white p-7">
              <img
                src={c.light.src}
                alt={c.name + ' illustration'}
                class="max-h-full max-w-full object-contain dark:hidden"
                loading="lazy"
              />
              <img
                src={c.dark.src}
                alt=""
                class="hidden max-h-full max-w-full object-contain dark:block"
                loading="lazy"
              />
            </div>
            <div class="dark:group-hover:text-quartz text-ink group-hover:text-mulberry dark:text-cream mt-4 font-serif text-2xl font-medium">
              {c.name}
            </div>
            <div class="dark:text-fog text-slate mt-2 text-base leading-relaxed">
              {c.description}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>
