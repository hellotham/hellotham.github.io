---
import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { PAGE_SIZE, getPosts } from '../../config'
import Base from '../../layouts/base.astro'
import PageHero from '../../components/pagehero.astro'
import BlogRoll from '../../components/blogroll.astro'
import PaginateControl from '../../components/paginatecontrol.astro'
import coverSVG from '../../assets/svg/rosely/undraw_my_feed-light.svg'
import coverSVGDark from '../../assets/svg/rosely/undraw_my_feed-dark.svg'
import socialImage from '../../assets/undraw/undraw_my_feed.png'

export async function getStaticPaths() {
  const posts = await getPosts()
  const total = posts.length
  const lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE))

  return Array.from({ length: lastPage }, (_, index) => {
    const currentPageNum = index + 1
    return {
      params: {
        page: currentPageNum === 1 ? undefined : String(currentPageNum)
      }
    }
  })
}

const { page: pageParam } = Astro.params
const currentPageNum = pageParam ? parseInt(pageParam, 10) : 1

const posts = await getPosts()
const total = posts.length
const lastPage = Math.ceil(total / PAGE_SIZE)

if (currentPageNum < 1 || (currentPageNum > lastPage && lastPage > 0)) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

const start = (currentPageNum - 1) * PAGE_SIZE
const end = Math.min(start + PAGE_SIZE, total)
const data = posts.slice(start, end)

const baseUrl = import.meta.env.BASE_URL + 'blog/'

const page = {
  data,
  start,
  end: end - 1,
  size: PAGE_SIZE,
  total,
  currentPage: currentPageNum,
  lastPage,
  url: {
    current: currentPageNum === 1 ? baseUrl : `${baseUrl}${currentPageNum}/`,
    prev:
      currentPageNum > 1
        ? currentPageNum === 2
          ? baseUrl
          : `${baseUrl}${currentPageNum - 1}/`
        : undefined,
    next: currentPageNum < lastPage ? `${baseUrl}${currentPageNum + 1}/` : undefined,
    first: baseUrl,
    last: lastPage > 1 ? `${baseUrl}${lastPage}/` : baseUrl
  }
} as Page<CollectionEntry<'blog'>>

const frontmatter: CollectionEntry<'page'>['data'] = {
  title:
    'Blog' +
    (page.size < page.total ? ' (page ' + page.currentPage + ' of ' + page.lastPage + ')' : ''),
  description: 'View our articles.',
  coverSVG: coverSVG,
  socialImage: socialImage
}

const currentPage = Astro.url.pathname.replace(/(\/\d*)?\/$/, '')
---

<Base frontmatter={frontmatter}>
  <header>
    <PageHero
      eyebrow="Insights"
      title="Blog"
      description={frontmatter.description}
      coverSVG={coverSVG}
      coverSVGDark={coverSVGDark}
      socialImage={frontmatter.socialImage}
    >
      <PaginateControl base={currentPage} page={page} />
    </PageHero>
  </header>
  <div class="dark:bg-ink-deep bg-cream">
    <BlogRoll posts={page.data} />
  </div>
</Base>
