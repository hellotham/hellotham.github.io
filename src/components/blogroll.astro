---
import type { CollectionEntry } from 'astro:content'
import BlogCard from '../components/blogcard.astro'

export interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props
---

<div
  data-future-list
  itemprop="mainEntity"
  itemscope
  itemtype="https://schema.org/Article"
  class="dark:bg-ink flex flex-wrap space-y-12 lg:space-y-0"
>
  <div
    data-future-empty
    class="border-line bg-cream text-ink dark:border-ink-soft dark:bg-ink-deep dark:text-cream hidden w-full rounded-lg border p-4"
  >
    No articles are available yet for the current date. Please check back soon.
  </div>
  {posts.map((post) => <BlogCard post={post} />)}
</div>
