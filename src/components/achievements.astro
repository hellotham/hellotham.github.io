---
import { CaseStudies } from '../config'

const baseUrl = import.meta.env.BASE_URL
---

<div class="dark:bg-ink bg-white">
  <div class="mx-auto max-w-7xl px-6 py-16 sm:px-10 lg:px-14 lg:py-20">
    <div class="mb-8 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-ink dark:text-cream font-serif text-3xl font-medium lg:text-4xl">
        Achievements
      </h2>
      <a
        href={baseUrl + 'work'}
        class="dark:text-quartz text-ink hover:text-mulberry font-mono text-xs tracking-widest uppercase dark:hover:text-white"
      >
        All work →
      </a>
    </div>
    {
      CaseStudies.map((cs) => (
        <div class="dark:border-ink-soft border-line grid gap-2 border-t py-7 lg:grid-cols-12 lg:gap-12">
          <div class="dark:text-aqua text-slate font-mono text-xs leading-relaxed lg:col-span-3">
            {cs.client}
          </div>
          <div class="lg:col-span-9">
            <div class="text-ink dark:text-cream mb-2 font-serif text-2xl font-medium">
              {cs.title}
            </div>
            <div class="dark:text-fog text-slate max-w-3xl text-base leading-relaxed">
              {cs.body}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</div>
