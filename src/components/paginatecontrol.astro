---
import { Icon } from 'astro-icon/components'
import type { CollectionEntry } from 'astro:content'
import type { Page } from 'astro'

export interface Props {
  base: string
  page: Page<CollectionEntry<'blog'>>
}

// const { id } = Astro.params
const { base, page } = Astro.props

const baseUrl = import.meta.env.BASE_URL
---

<div class="mt-8 flex flex-wrap items-center gap-y-3">
  <a
    href={baseUrl + 'categories'}
    class="border-ink text-ink hover:border-mulberry hover:text-mulberry dark:border-slate dark:text-cream dark:hover:border-quartz dark:hover:text-quartz inline-block rounded border px-3 py-1 font-mono text-xs tracking-widest uppercase"
  >
    Categories
  </a>
  <a
    href={baseUrl + 'tags'}
    class="border-ink text-ink hover:border-mulberry hover:text-mulberry dark:border-slate dark:text-cream dark:hover:border-quartz dark:hover:text-quartz ml-3 inline-block rounded border px-3 py-1 font-mono text-xs tracking-widest uppercase"
  >
    Tags
  </a>
  <a
    href={baseUrl + 'authors'}
    class="border-ink text-ink hover:border-mulberry hover:text-mulberry dark:border-slate dark:text-cream dark:hover:border-quartz dark:hover:text-quartz ml-3 inline-block rounded border px-3 py-1 font-mono text-xs tracking-widest uppercase"
  >
    Authors
  </a>
  {
    page.size < page.total && (
      <div class="ml-4">
        <nav
          class="relative z-0 inline-flex -space-x-px rounded-md shadow-sm"
          aria-label="Pagination"
        >
          <a
            href={page.url.prev || '#'}
            class:list={[
              'relative inline-flex items-center rounded-l-md border px-2 py-2 text-sm font-medium',
              page.url.prev
                ? 'border-line text-slate hover:bg-cream dark:border-ink-soft dark:bg-ink dark:text-fog dark:hover:bg-ink-soft bg-white'
                : 'border-line text-slate dark:border-ink-soft dark:bg-ink-soft bg-line dark:text-fog'
            ]}
          >
            <span class="sr-only">Previous</span>
            <Icon class="h-5 w-5" name="ph:caret-left-bold" />
          </a>
          {Array.from({ length: page.lastPage }, (_, index) => index + 1).map((i) => (
            <a
              href={base + '/' + (i > 1 ? i : '')}
              aria-current="page"
              class:list={[
                i == page.currentPage
                  ? 'border-mulberry bg-cream text-mulberry dark:border-quartz dark:bg-plum dark:text-quartz z-10'
                  : 'border-line text-slate hover:bg-cream dark:border-ink-soft dark:bg-ink dark:text-fog dark:hover:bg-ink-soft bg-white',
                'relative inline-flex items-center border px-4 py-2 text-sm font-medium'
              ]}
            >
              {i}
            </a>
          ))}
          <a
            href={page.url.next || '#'}
            class:list={[
              'relative inline-flex items-center rounded-r-md border px-2 py-2 text-sm font-medium',
              page.url.next
                ? 'border-line text-slate hover:bg-cream dark:border-ink-soft dark:bg-ink dark:text-fog dark:hover:bg-ink-soft bg-white'
                : 'border-line text-slate dark:border-ink-soft dark:bg-ink-soft bg-line dark:text-fog'
            ]}
          >
            <span class="sr-only">Next</span>
            <Icon class="h-5 w-5" name="ph:caret-right-bold" />
          </a>
        </nav>
      </div>
    )
  }
  <p class="text-slate dark:text-fog ml-4 text-sm italic">
    Articles {page.start + 1}-{page.end + 1} (total {page.total})
  </p>
</div>
