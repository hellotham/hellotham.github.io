---
export const prerender = false

import { getEntry, render } from 'astro:content'
import Layout from '../../layouts/blog.astro'
import { getPosts } from '../../config'

const { id } = Astro.params
if (!id) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

const post = await getEntry('blog', id)
if (!post) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

const now = new Date()
if (post.data.draft || post.data.publishDate > now) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

const posts = await getPosts()
const index = posts.findIndex((p) => p.id === post.id)
const prev = index > 0 ? posts[index - 1] : undefined
const next = index < posts.length - 1 ? posts[index + 1] : undefined

const { Content, remarkPluginFrontmatter } = await render(post)
let fm = post.data
const rfm = remarkPluginFrontmatter as any
if (rfm) {
  fm.minutesRead = rfm.minutesRead
  fm.extra = rfm.extra
}
---

<Layout {post} {prev} {next}>
  <Content />
</Layout>
