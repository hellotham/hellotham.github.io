---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../layouts/base.astro'
import { Services } from '../config'
import LogoBadge from '../assets/site/hellotham-logo-1000x1000.png'
import IdeasFlowLight from '../assets/svg/rosely/undraw_ideas_flow-light.svg'
import IdeasFlowDark from '../assets/svg/rosely/undraw_ideas_flow-dark.svg'
import socialImage from '../assets/home.jpg'

const baseUrl = import.meta.env.BASE_URL

const frontmatter: CollectionEntry<'page'>['data'] = {
  title: 'About Us',
  description: 'Company profile, quality, risk and privacy',
  socialImage: socialImage
}

const linkClass = 'text-mulberry hover:text-rose dark:text-quartz dark:hover:text-white'

const stack = [
  { name: 'Astro 7', href: 'https://astro.build', note: 'static-first web framework' },
  { name: 'TypeScript', href: 'https://www.typescriptlang.org/', note: 'typed end to end' },
  { name: 'Tailwind CSS 4', href: 'https://tailwindcss.com', note: 'design tokens and utilities' },
  {
    name: 'Hello Astro',
    href: 'https://hellotham.com/hello-astro/',
    note: 'our own starter theme'
  },
  {
    name: 'Rosely',
    href: 'https://rosely.hellotham.com',
    note: 'our design system, light and dark'
  },
  {
    name: 'Noto fonts',
    href: 'https://fonts.google.com/noto',
    note: 'self-hosted via the Astro Fonts API'
  },
  { name: 'Markdown, MDX & Markdoc', href: 'https://mdxjs.com/', note: 'content pipelines' },
  { name: 'Mermaid & Markmap', href: 'https://mermaid.js.org/', note: 'diagrams, plus KaTeX math' },
  { name: 'Pagefind', href: 'https://pagefind.app/', note: 'local full-text search' },
  { name: 'Heroicons & Bootstrap Icons', href: 'https://heroicons.com/', note: 'via astro-icon' },
  { name: 'unDraw', href: 'https://undraw.co/', note: 'illustrations, recoloured to Rosely' },
  { name: 'Leaflet', href: 'https://leafletjs.com/', note: 'the contact page map' },
  {
    name: 'Schema.org & Open Graph',
    href: 'https://schema.org/',
    note: 'JSON-LD and social cards'
  },
  { name: 'ESLint & Prettier', href: 'https://eslint.org', note: 'linting and formatting' },
  { name: 'GitHub Pages', href: 'https://pages.github.com/', note: 'hosting and CI' },
  { name: 'Netlify', href: 'https://www.netlify.com/', note: 'hosting and contact form delivery' }
]

const statements = [
  {
    num: '01',
    label: 'Quality',
    title: 'Quality Statement',
    intro:
      'Quality matters to us because clients engage us on trust, and our work only counts when it delivers the outcomes they need. We are committed to meeting the requirements that apply to every engagement — our client’s, and all statutory and regulatory obligations — and to continually improving how we work. As a boutique firm we do not operate a certified Quality Management System; instead, our practice is structured around the seven quality management principles of ISO 9000:2015, applied as follows:',
    ordered: true,
    points: [
      'Customer focus — we define success in the client’s terms at the start of each engagement, gather and monitor client feedback throughout, and measure ourselves against agreed outcomes rather than effort expended.',
      'Leadership — our Principal owns quality personally, sets measurable quality objectives for our consulting services that reflect our business aims, and reviews performance against them at planned intervals.',
      'Engagement of people — every consultant and sub-contractor is responsible for quality within their own area of work, supported by ongoing training and professional development.',
      'Process approach — we deliver through defined consulting methodologies, tools and internal processes, reviewed regularly so that related activities are managed as one coherent system.',
      'Improvement — findings from management reviews, client feedback and complaints feed corrective action and refinements to our methods; continual improvement is a standing objective of the business.',
      'Evidence-based decision making — our recommendations to clients and our own management decisions are grounded in data and analysis, and every completed engagement is reviewed at management level.',
      'Relationship management — we manage relationships with clients, partners and sub-contractors for the long term, sharing expectations and feedback openly in both directions.'
    ],
    outro:
      'This statement provides the framework for setting and reviewing our quality objectives. The Principal of the Company holds ultimate responsibility for quality, communicates this statement to everyone who works with us, and reviews it as part of our management reviews. It is published on this website so that it remains available to clients and other interested parties.'
  },
  {
    num: '02',
    label: 'Risk',
    title: 'Risk Management Statement',
    intro:
      'We manage risk as ISO 31000:2018 defines it — the effect of uncertainty on objectives, ours and our clients’, whether that effect is a threat to be reduced or an opportunity to be taken. The purpose of our risk management is to create and protect value: it is led personally by our Principal, integrated into our governance and into every engagement rather than run as a separate activity, and customised to the scale of a boutique firm. For the business each year, and for each material decision and engagement, we apply the ISO 31000 risk management process:',
    ordered: true,
    points: [
      'Scope, context and criteria — we establish what is at stake, the internal and external context, and the criteria against which risk will be evaluated.',
      'Risk identification — we identify the uncertainties that could affect objectives, including the personal health and safety of our people and the public, and professional, financial, legal and reputational exposures — as well as the opportunities uncertainty presents.',
      'Risk analysis — we analyse likelihood and consequence using the best available information, recognising its limits and the human and cultural factors involved.',
      'Risk evaluation — we compare analysed risks against our criteria to decide which require treatment, and in what priority.',
      'Risk treatment — we avoid activities where the potential loss outweighs the potential benefit, reduce risks through mitigation and contingency planning, share them where appropriate through a cost-effective balance of insurance and contract, and accept remaining risks knowingly.',
      'Monitoring, review and recording — treatments and risks are documented, monitored and reviewed; losses and near-misses are investigated and support is provided to anyone affected, with lessons feeding continual improvement of the process itself.',
      'Communication and consultation — throughout the process we consult clients, employees, suppliers and sub-contractors, raising awareness of risk management across our organisation.'
    ],
    outro:
      'Applied this way, our risk management stays proportionate, dynamic as our context changes, and continually improving through what we learn. In consulting engagements we operate within — and in alignment with — each client’s own risk management framework, policies and procedures, consistent with the principles and guidelines of ISO 31000:2018.'
  },
  {
    num: '03',
    label: 'Privacy',
    title: 'Privacy Policy',
    intro:
      'We respect and adhere to client confidentiality in the work we perform on behalf of our clients, and will not disclose any information without our client’s approval.',
    ordered: false,
    points: [],
    outro: ''
  }
]
---

<Base {frontmatter}>
  <div class="dark:border-ink-soft border-line dark:bg-ink border-b bg-white">
    <div class="mx-auto grid max-w-7xl lg:grid-cols-12">
      <div class="px-6 py-14 sm:px-10 lg:col-span-7 lg:px-14 lg:py-18">
        <p class="dark:text-aqua text-mulberry mb-5 font-mono text-xs tracking-widest uppercase">
          About us
        </p>
        <h1
          class="text-ink dark:text-cream font-serif text-4xl leading-none font-medium tracking-tight sm:text-5xl"
        >
          A boutique firm, holistic by design.
        </h1>
        <p class="text-slate dark:text-fog mt-6 max-w-xl text-lg leading-relaxed">
          Hello Tham is a boutique management consulting firm, registered in Australia (ABN 44 617
          279 115). We deliver consulting services to clients around the world — and we implement
          what we recommend.
        </p>
      </div>
      <div
        class="dark:border-ink-soft dark:bg-plum border-line bg-quartz flex items-center justify-center border-t p-8 sm:p-10 lg:col-span-5 lg:border-t-0 lg:border-l"
      >
        <img
          src={IdeasFlowLight.src}
          width={IdeasFlowLight.width}
          height={IdeasFlowLight.height}
          alt=""
          class="max-h-64 w-full object-contain dark:hidden"
        />
        <img
          src={IdeasFlowDark.src}
          width={IdeasFlowDark.width}
          height={IdeasFlowDark.height}
          alt=""
          class="hidden max-h-64 w-full object-contain dark:block"
        />
      </div>
    </div>
  </div>

  <div class="dark:bg-ink bg-white">
    <div
      class="mx-auto grid max-w-7xl gap-10 px-6 py-14 sm:px-10 lg:grid-cols-12 lg:gap-16 lg:px-14 lg:py-16"
    >
      <div class="lg:col-span-4">
        <p class="dark:text-aqua text-mulberry mb-4 font-mono text-xs tracking-widest uppercase">
          What we do
        </p>
        <h2 class="text-ink dark:text-cream font-serif text-3xl leading-tight font-medium">
          We specialise in
        </h2>
        <p class="dark:text-fog text-slate mt-4 text-base leading-relaxed">
          Seven practices, engaged individually or as one accountable team. We also assist our
          clients in implementing our recommendations, models and strategies.
        </p>
        <a
          href={baseUrl + 'services'}
          class="dark:text-quartz text-ink hover:text-mulberry mt-5 inline-block font-mono text-xs tracking-widest uppercase dark:hover:text-white"
        >
          Explore services →
        </a>
      </div>
      <div class="grid gap-x-10 sm:grid-cols-2 lg:col-span-8">
        {
          Services.map((sv) => (
            <div class="dark:border-ink-soft border-line flex items-baseline gap-4 border-t py-4">
              <span class="dark:text-grape text-mulberry font-mono text-sm">{sv.num}</span>
              <span class="text-ink dark:text-cream font-serif text-lg font-medium">{sv.name}</span>
            </div>
          ))
        }
      </div>
    </div>
  </div>

  <div class="dark:border-ink-soft dark:bg-ink-deep border-line bg-cream border-t">
    <div class="mx-auto grid max-w-7xl gap-8 px-6 py-14 sm:px-10 lg:grid-cols-2 lg:px-14 lg:py-16">
      <div class="dark:border-ink-soft dark:bg-ink border-line flex flex-col border bg-white">
        <div
          class="dark:border-ink-soft dark:bg-plum border-line bg-cream flex grow items-center justify-center border-b p-10"
        >
          <Image src={LogoBadge} alt="Hello Tham logo" width={600} class="w-56 sm:w-72" />
        </div>
        <div class="p-7">
          <p class="text-mulberry dark:text-grape font-mono text-xs tracking-widest uppercase">
            Our logo
          </p>
          <h2 class="text-ink dark:text-cream mt-2 font-serif text-2xl font-medium">
            Hello Tham Logo
          </h2>
          <p class="text-slate dark:text-fog mt-3 text-base leading-relaxed">
            Our logo reflects who we are and our values. The Circle reflects our holistic approach
            to delivering services to our clients. The Eyes reflect the insights we provide through
            the outcomes we achieve. The Gear reflects the type of services we provide, which
            require different parts to interoperate and flow — as does our technology.
          </p>
        </div>
      </div>

      <div class="dark:border-ink-soft dark:bg-ink border-line border bg-white p-7">
        <p class="text-mulberry dark:text-grape font-mono text-xs tracking-widest uppercase">
          About this website
        </p>
        <h2 class="text-ink dark:text-cream mt-2 font-serif text-2xl font-medium">
          Website Design
        </h2>
        <p class="text-slate dark:text-fog mt-3 text-base leading-relaxed">
          This site is designed by us, built by us and deployed to both GitHub Pages and Netlify. It
          is a static-first website built with:
        </p>
        <ul class="mt-4 grid gap-x-8 gap-y-1.5 sm:grid-cols-2">
          {
            stack.map((t) => (
              <li class="text-slate dark:text-fog text-sm leading-relaxed">
                <a href={t.href} class={linkClass} rel="noopener noreferrer" target="_blank">
                  {t.name}
                </a>
                <span class="text-fog dark:text-slate"> — {t.note}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>

  <div class="dark:bg-ink bg-white">
    <div class="mx-auto max-w-7xl px-6 py-14 sm:px-10 lg:px-14 lg:py-16">
      <div class="mb-10 text-center">
        <p class="dark:text-aqua text-mulberry font-mono text-xs tracking-widest uppercase">
          How we hold ourselves to account
        </p>
        <h2 class="text-ink dark:text-cream mt-3 font-serif text-3xl font-medium lg:text-4xl">
          Quality, risk and privacy
        </h2>
      </div>
      <div class="mx-auto flex max-w-3xl flex-col gap-8">
        {
          statements.map((s) => (
            <article class="dark:border-ink-soft dark:bg-ink-deep border-line bg-cream border p-7 shadow-sm sm:p-10">
              <div class="dark:border-ink-soft border-line flex items-baseline justify-between border-b pb-4">
                <p class="text-mulberry dark:text-grape font-mono text-xs tracking-widest uppercase">
                  Statement {s.num} · {s.label}
                </p>
                <span class="text-fog font-mono text-xs tracking-widest uppercase">
                  Hello Tham Pty Ltd
                </span>
              </div>
              <h3 class="text-ink dark:text-cream mt-5 font-serif text-2xl font-medium">
                {s.title}
              </h3>
              <p class="text-slate dark:text-fog mt-4 text-base leading-relaxed">{s.intro}</p>
              {s.points.length > 0 && (
                <ul class="mt-4 flex flex-col gap-2.5">
                  {s.points.map((p, i) => (
                    <li class="text-slate dark:text-fog flex gap-3 text-base leading-relaxed">
                      <span class="dark:text-grape text-mulberry font-mono text-xs leading-6">
                        {s.ordered ? String(i + 1).padStart(2, '0') : '—'}
                      </span>
                      <span>{p}</span>
                    </li>
                  ))}
                </ul>
              )}
              {s.outro && (
                <p class="text-slate dark:text-fog mt-4 text-base leading-relaxed">{s.outro}</p>
              )}
              {s.label === 'Risk' && (
                <p class="text-slate dark:text-fog mt-4 text-base leading-relaxed">
                  As a legal employer in New South Wales, we hold a workers compensation insurance
                  policy with icare NSW (policy no. 144478201). We also maintain Professional
                  Indemnity insurance ($1 million) and Public Liability insurance ($10 million)
                  underwritten by CGU Insurance (policy no. 06MIS2800490). A certificate of currency
                  is available on request.
                </p>
              )}
              {s.label === 'Privacy' && (
                <p class="text-slate dark:text-fog mt-4 text-base leading-relaxed">
                  Our privacy policy for this website is published separately:{' '}
                  <a href={baseUrl + 'privacy'} class={linkClass}>
                    Privacy Policy
                  </a>
                  .
                </p>
              )}
            </article>
          ))
        }
      </div>
    </div>
  </div>
</Base>
