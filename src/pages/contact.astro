---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Base from '../layouts/base.astro'
import Map from '../components/map.astro'
import type { CollectionEntry } from 'astro:content'
import { SiteMetadata } from '../config'
import ContactLight from '../assets/svg/rosely/undraw_contact-light.svg'
import ContactDark from '../assets/svg/rosely/undraw_contact-dark.svg'
import socialImage from '../assets/social/contact.png'

const frontmatter: CollectionEntry<'page'>['data'] = {
  title: 'Contact',
  description: 'Our presence is real and digital. Contact us through the following ways.',
  socialImage: socialImage
}

const social = await getCollection('social')

// Preflight zeroes border-width, so form controls need an explicit `border`
// alongside the token colour, plus their own padding and focus ring.
const fieldClass =
  'border-line dark:border-ink-soft text-ink dark:bg-ink dark:text-cream focus:border-mulberry dark:focus:border-quartz focus:ring-mulberry/40 mt-2 block w-full border bg-white px-3.5 py-2.5 text-base focus:ring-2 focus:outline-none'
const labelClass = 'text-slate dark:text-fog block font-mono text-xs tracking-widest uppercase'
---

<Base frontmatter={frontmatter} schema="ContactPage">
  <header class="dark:border-ink-soft border-line dark:bg-ink border-b bg-white">
    <div class="mx-auto grid max-w-7xl lg:grid-cols-12">
      <div class="px-6 py-14 sm:px-10 lg:col-span-7 lg:px-14 lg:py-18">
        <p class="dark:text-aqua text-mulberry mb-5 font-mono text-xs tracking-widest uppercase">
          Contact
        </p>
        <h1
          class="text-ink dark:text-cream font-serif text-4xl leading-none font-medium tracking-tight sm:text-5xl"
        >
          Let’s start a conversation.
        </h1>
        <p class="text-slate dark:text-fog mt-6 max-w-xl text-lg leading-relaxed">
          Our presence is both real and digital. Tell us what you are working through — by form,
          email or any of the channels below.
        </p>
      </div>
      <div
        class="dark:border-ink-soft dark:bg-plum border-line bg-quartz flex items-center justify-center border-t p-8 sm:p-10 lg:col-span-5 lg:border-t-0 lg:border-l"
      >
        <img
          src={ContactLight.src}
          width={ContactLight.width}
          height={ContactLight.height}
          alt=""
          class="max-h-64 w-full object-contain dark:hidden"
        />
        <img
          src={ContactDark.src}
          width={ContactDark.width}
          height={ContactDark.height}
          alt=""
          class="hidden max-h-64 w-full object-contain dark:block"
        />
      </div>
    </div>
  </header>
  <div itemprop="mainContentOfPage">
    <section class="text-ink dark:text-cream mx-auto mb-20 max-w-7xl px-6 pt-12 sm:px-10 lg:px-14">
      <div class="dark:bg-ink block bg-white">
        <div class="flex flex-wrap items-start">
          <div class="block w-full shrink-0 grow-0 basis-auto lg:flex lg:w-6/12 xl:w-4/12">
            <div class="w-full">
              <Map loc={SiteMetadata.latlng} zoom={11} />
            </div>
          </div>
          <div class="w-full shrink-0 grow-0 basis-auto lg:w-6/12 xl:w-8/12">
            <div class="mb-6 px-3 md:px-6 xl:px-12">
              <p class="text-slate dark:text-fog">
                Our common handle across Facebook, X and Instagram is @HelloThamCom. You may also
                contact us through any of the following:
              </p>
            </div>
            <div class="flex flex-wrap pt-8 lg:pt-0">
              {
                social.map(
                  (method) =>
                    method.data.link && (
                      <div class="mb-12 w-full shrink-0 grow-0 basis-auto px-3 md:w-6/12 md:px-6 lg:w-full xl:w-6/12 xl:px-12">
                        <div class="flex items-start">
                          <div class="shrink-0">
                            <Icon
                              name={'ph:' + method.data.icon}
                              class="bg-ink flex h-14 w-14 items-center justify-center rounded-md p-4 text-white shadow-md"
                            />
                          </div>
                          <div class="ml-6 min-w-0 grow">
                            <p class="mb-1 font-bold">{method.data.name}</p>
                            <p>
                              <a
                                href={method.data.link}
                                class="text-mulberry hover:text-rose dark:text-quartz break-all dark:hover:text-white"
                              >
                                {method.data.link}
                              </a>
                            </p>
                          </div>
                        </div>
                      </div>
                    )
                )
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Netlify Contact Form Section -->
      <div class="border-line bg-cream dark:border-ink-soft dark:bg-ink-deep mt-12 border">
        <div class="grid gap-10 p-7 sm:p-10 lg:grid-cols-12 lg:gap-14">
          <div class="lg:col-span-4">
            <p class="text-mulberry dark:text-grape font-mono text-xs tracking-widest uppercase">
              Enquiries
            </p>
            <h2
              id="contact-form-heading"
              class="text-ink dark:text-cream mt-2 font-serif text-3xl font-medium"
            >
              Send us a message
            </h2>
            <p class="text-slate dark:text-fog mt-4 text-base leading-relaxed">
              Tell us what you are working through and we will respond personally. Every enquiry
              reaches our Principal directly.
            </p>
          </div>

          <form
            name="contact"
            method="POST"
            action="https://hellotham.netlify.app/thanks"
            data-netlify="true"
            netlify-honeypot="bot-field"
            aria-labelledby="contact-form-heading"
            class="lg:col-span-8"
          >
            <input type="hidden" name="form-name" value="contact" />
            <p class="hidden">
              <label>
                Don’t fill this out if you’re human: <input name="bot-field" />
              </label>
            </p>

            <div class="grid gap-5 sm:grid-cols-2">
              <div>
                <label for="name" class={labelClass}>
                  Name <span class="text-mulberry dark:text-grape" aria-hidden="true">*</span>
                </label>
                <input
                  type="text"
                  id="name"
                  name="name"
                  required
                  autocomplete="name"
                  class={fieldClass}
                />
              </div>

              <div>
                <label for="email" class={labelClass}>
                  Email address <span class="text-mulberry dark:text-grape" aria-hidden="true"
                    >*</span
                  >
                </label>
                <input
                  type="email"
                  id="email"
                  name="email"
                  required
                  autocomplete="email"
                  class={fieldClass}
                />
              </div>

              <div>
                <label for="phone" class={labelClass}
                  >Phone <span class="normal-case">(optional)</span></label
                >
                <input type="tel" id="phone" name="phone" autocomplete="tel" class={fieldClass} />
              </div>

              <div>
                <label for="subject" class={labelClass}>Subject</label>
                <input type="text" id="subject" name="subject" class={fieldClass} />
              </div>

              <div class="sm:col-span-2">
                <label for="text" class={labelClass}>
                  Message <span class="text-mulberry dark:text-grape" aria-hidden="true">*</span>
                </label>
                <textarea rows={6} id="text" name="text" required class={fieldClass}></textarea>
              </div>
            </div>

            <div class="mt-7 flex flex-wrap items-center justify-between gap-4">
              <p class="text-fog dark:text-slate font-mono text-xs tracking-widest uppercase">
                <span class="text-mulberry dark:text-grape">*</span> Required
              </p>
              <button
                type="submit"
                class="dark:bg-quartz text-cream hover:bg-mulberry dark:text-ink bg-ink focus:ring-mulberry rounded px-7 py-3.5 text-base font-semibold focus:ring-2 focus:ring-offset-2 focus:outline-none dark:hover:bg-white"
              >
                Send message
              </button>
            </div>
          </form>
        </div>
      </div>
    </section>
  </div>
</Base>
