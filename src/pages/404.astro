---
import type { CollectionEntry } from 'astro:content'
import Base from '../layouts/base.astro'
import PageHero from '../components/pagehero.astro'
import coverSVG from '../assets/svg/rosely/undraw_page_not_found-light.svg'
import coverSVGDark from '../assets/svg/rosely/undraw_page_not_found-dark.svg'
import socialImage from '../assets/social/page_not_found.png'

const frontmatter: CollectionEntry<'page'>['data'] = {
  title: '404: Not found',
  description: "You just hit a route that doesn't exist... the sadness.",
  coverSVG: coverSVG,
  socialImage: socialImage
}
---

<Base frontmatter={frontmatter}>
  <header>
    <PageHero
      title={frontmatter.title}
      description={frontmatter.description}
      coverSVG={coverSVG}
      coverSVGDark={coverSVGDark}
      socialImage={frontmatter.socialImage}
    />
  </header>
</Base>
