---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import Base from '../layouts/base.astro'
import Map from '../components/map.astro'
import PageHero from '../components/pagehero.astro'
import type { CollectionEntry } from 'astro:content'
import { SiteMetadata } from '../config'
import coverSVG from '../assets/svg/undraw/undraw_contact_us.svg'
import socialImage from '../assets/undraw/undraw_contact_us.png'

const frontmatter: CollectionEntry<'page'>['data'] = {
  title: 'Contact',
  description: 'Our presence is real and digital. Contact us through the following ways.',
  coverSVG: coverSVG,
  socialImage: socialImage
}

const social = await getCollection('social')
---

<Base frontmatter={frontmatter} schema="ContactPage">
  <header>
    <PageHero
      title={frontmatter.title}
      description={frontmatter.description}
      coverSVG={coverSVG}
      socialImage={socialImage}
    />
  </header>
  <div itemprop="mainContentOfPage">
    <section class="text-ink dark:text-cream mx-auto mb-20 max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="dark:bg-ink block bg-white lg:my-8">
        <div class="flex flex-wrap items-start">
          <div class="block w-full shrink-0 grow-0 basis-auto lg:flex lg:w-6/12 xl:w-4/12">
            <div class="w-full">
              <Map loc={SiteMetadata.latlng} zoom={11} />
            </div>
          </div>
          <div class="w-full shrink-0 grow-0 basis-auto lg:w-6/12 xl:w-8/12">
            <div class="mb-6 px-3 md:px-6 xl:px-12">
              <p class="text-slate dark:text-fog">
                Our common id across Facebook, Twitter and Instagram is @HelloThamCom. In addition,
                you may contact us through the following means:
              </p>
            </div>
            <div class="flex flex-wrap pt-8 lg:pt-0">
              {
                social.map(
                  (method) =>
                    method.data.link && (
                      <div class="mb-12 w-full shrink-0 grow-0 basis-auto px-3 md:w-6/12 md:px-6 lg:w-full xl:w-6/12 xl:px-12">
                        <div class="flex items-start">
                          <div class="shrink-0">
                            <Icon
                              name={'bi:' + method.data.icon}
                              class="bg-ink flex h-14 w-14 items-center justify-center rounded-md p-4 text-white shadow-md"
                            />
                          </div>
                          <div class="ml-6 grow">
                            <p class="mb-1 font-bold">{method.data.name}</p>
                            <p>
                              {' '}
                              <a
                                href={method.data.link}
                                class="text-mulberry hover:text-rose dark:text-quartz dark:hover:text-white"
                              >
                                {method.data.link}
                              </a>
                            </p>
                          </div>
                        </div>
                      </div>
                    )
                )
              }
            </div>
          </div>
        </div>
      </div>

      <!-- Netlify Contact Form Section -->
      <div
        class="border-line bg-cream dark:border-ink-soft dark:bg-ink-deep mt-12 rounded-lg border p-8"
      >
        <div class="lg:grid lg:grid-cols-3 lg:gap-6">
          <div class="lg:col-span-1">
            <div class="px-4 sm:px-0">
              <h3 class="text-ink dark:text-cream text-lg leading-6 font-bold">
                Send us a message
              </h3>
              <p class="text-slate dark:text-fog mt-2 text-sm">
                Our common handle across Facebook, Twitter/X and Instagram is @HelloThamCom. In
                addition, you may contact us using this secure form.
              </p>
            </div>
          </div>

          <div class="mt-5 lg:col-span-2 lg:mt-0">
            <form
              name="contact"
              method="POST"
              action="https://hellotham.netlify.app/"
              data-netlify="true"
              netlify-honeypot="bot-field"
            >
              <input type="hidden" name="form-name" value="contact" />
              <p class="hidden">
                <label>
                  Don’t fill this out if you’re human: <input name="bot-field" />
                </label>
              </p>
              <div class="overflow-hidden shadow sm:rounded-md">
                <div class="dark:bg-ink bg-white px-4 py-5 sm:p-6">
                  <div class="grid grid-cols-6 gap-6">
                    <div class="col-span-6">
                      <label for="name" class="text-slate dark:text-fog block text-sm font-medium"
                        >Name</label
                      >
                      <input
                        type="text"
                        id="name"
                        name="name"
                        class="border-line text-ink focus:border-mulberry focus:ring-mulberry dark:border-ink-soft dark:bg-ink-deep dark:text-cream mt-1 block w-full rounded-md bg-white shadow-sm sm:text-sm"
                      />
                    </div>

                    <div class="col-span-6">
                      <label for="email" class="text-slate dark:text-fog block text-sm font-medium"
                        >Email address</label
                      >
                      <input
                        type="email"
                        id="email"
                        name="email"
                        class="border-line text-ink focus:border-mulberry focus:ring-mulberry dark:border-ink-soft dark:bg-ink-deep dark:text-cream mt-1 block w-full rounded-md bg-white shadow-sm sm:text-sm"
                      />
                    </div>

                    <div class="col-span-6">
                      <label for="phone" class="text-slate dark:text-fog block text-sm font-medium"
                        >Phone</label
                      >
                      <input
                        type="tel"
                        id="phone"
                        name="phone"
                        class="border-line text-ink focus:border-mulberry focus:ring-mulberry dark:border-ink-soft dark:bg-ink-deep dark:text-cream mt-1 block w-full rounded-md bg-white shadow-sm sm:text-sm"
                      />
                    </div>

                    <div class="col-span-6">
                      <label
                        for="subject"
                        class="text-slate dark:text-fog block text-sm font-medium">Subject</label
                      >
                      <input
                        type="text"
                        id="subject"
                        name="subject"
                        class="border-line text-ink focus:border-mulberry focus:ring-mulberry dark:border-ink-soft dark:bg-ink-deep dark:text-cream mt-1 block w-full rounded-md bg-white shadow-sm sm:text-sm"
                      />
                    </div>

                    <div class="col-span-6">
                      <label for="text" class="text-slate dark:text-fog block text-sm font-medium"
                        >Message</label
                      >
                      <textarea
                        rows={5}
                        id="text"
                        name="text"
                        placeholder="Enter your message here."
                        class="border-line text-ink focus:border-mulberry focus:ring-mulberry dark:border-ink-soft dark:bg-ink-deep dark:text-cream mt-1 block w-full rounded-md bg-white shadow-sm sm:text-sm"
                      ></textarea>
                    </div>
                  </div>
                </div>

                <div class="bg-cream dark:bg-ink-deep px-4 py-3 text-right sm:px-6">
                  <button
                    type="submit"
                    class="bg-ink hover:bg-mulberry focus:ring-mulberry inline-flex justify-center rounded-md border border-transparent px-4 py-2 text-sm font-medium text-white shadow-sm focus:ring-2 focus:ring-offset-2 focus:outline-none"
                  >
                    Send
                  </button>
                </div>
              </div>
            </form>
          </div>
        </div>
      </div>
    </section>
  </div>
</Base>
