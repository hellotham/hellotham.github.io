---
import HelloTham from '../assets/site/hellotham.svg'
import IdeasFlowLight from '../assets/svg/rosely/undraw_ideas_flow-light.svg'
import IdeasFlowDark from '../assets/svg/rosely/undraw_ideas_flow-dark.svg'

const baseUrl = import.meta.env.BASE_URL
---

<div
  class="dark:border-ink-soft border-line dark:bg-ink relative overflow-hidden border-b bg-white"
>
  <div class="mx-auto max-w-7xl">
    <div class="dark:bg-ink relative z-10 bg-white pb-10 lg:w-full lg:max-w-2xl lg:pb-12">
      <svg
        class="dark:text-ink absolute inset-y-0 right-0 hidden h-full w-48 translate-x-1/2 transform text-white lg:block"
        fill="currentColor"
        viewBox="0 0 100 100"
        preserveAspectRatio="none"
        aria-hidden="true"
      >
        <polygon points="50,0 100,0 50,100 0,100"></polygon>
      </svg>
      <div class="relative px-6 pt-10 sm:px-10 lg:px-14 lg:pt-12">
        <img src={HelloTham.src} width="350" alt="Hello Tham" class="mb-6 w-70 sm:w-88" />
        <h1
          class="text-ink dark:text-cream font-serif text-3xl leading-none font-medium tracking-tight sm:text-5xl sm:whitespace-nowrap lg:text-5xl"
        >
          Visualise Your <span class="text-mulberry dark:text-quartz">Future</span>
        </h1>
        <p class="text-slate dark:text-fog mt-5 max-w-lg text-lg leading-relaxed">
          Hello Tham is a boutique management consulting firm.
        </p>
        <p class="text-slate dark:text-fog mt-4 max-w-lg text-lg leading-relaxed">
          We specialise in Business and IT strategies, operating models, strategic roadmaps,
          enterprise architecture, analytics and business process design.
        </p>
        <p class="text-slate dark:text-fog mt-4 max-w-lg text-lg leading-relaxed">
          We also assist our clients in implementing recommendations, models and strategies.
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a
            href={baseUrl + 'about'}
            class="dark:bg-quartz text-cream hover:bg-mulberry dark:text-ink bg-ink rounded px-7 py-3.5 text-base font-semibold dark:hover:bg-white"
          >
            About Us
          </a>
          <a
            href={baseUrl + 'contact'}
            class="text-ink hover:border-mulberry hover:text-mulberry dark:border-slate dark:text-cream dark:hover:border-quartz dark:hover:text-quartz border-ink rounded border px-7 py-3.5 text-base font-semibold"
          >
            Contact Us
          </a>
        </div>
      </div>
    </div>
  </div>
  <div class="bg-quartz dark:bg-plum lg:absolute lg:inset-y-0 lg:right-0 lg:w-1/2">
    <img
      class="h-56 w-full object-cover sm:h-72 md:h-96 lg:h-full lg:w-full dark:hidden"
      src={IdeasFlowLight.src}
      alt=""
      fetchpriority="high"
    />
    <img
      class="hidden h-56 w-full object-cover sm:h-72 md:h-96 lg:h-full lg:w-full dark:block"
      src={IdeasFlowDark.src}
      alt=""
      fetchpriority="high"
    />
  </div>
</div>
