---
import type { CollectionEntry } from 'astro:content'

export interface Props {
  posts: CollectionEntry<'blog'>[]
}

const { posts } = Astro.props

const latest = posts.slice(0, 6)

const baseUrl = import.meta.env.BASE_URL

const formatDate = (d: Date) =>
  d.toLocaleDateString('en-AU', { day: '2-digit', month: 'short', year: 'numeric' })
---

<div class="dark:border-ink-soft dark:bg-ink-deep border-line bg-cream border-t">
  <div class="mx-auto max-w-7xl px-6 py-14 sm:px-10 lg:px-14 lg:py-16">
    <div class="mb-7 flex flex-wrap items-baseline justify-between gap-4">
      <h2 class="text-ink dark:text-cream font-serif text-2xl font-medium lg:text-3xl">Insights</h2>
      <a
        href={baseUrl + 'blog'}
        class="dark:text-quartz text-ink hover:text-mulberry font-mono text-xs tracking-[.14em] uppercase dark:hover:text-white"
      >
        All articles →
      </a>
    </div>
    <div class="grid gap-x-8 gap-y-10 sm:grid-cols-2 lg:grid-cols-3">
      {
        latest.map((post) => {
          const postDate = post.data.publishDate || post.data.pubDate
          return (
            <a
              href={baseUrl + 'blog/' + post.id}
              data-future-mode="show"
              data-publish-date={postDate ? postDate.toISOString() : undefined}
              class="future-hidden group dark:border-ink-soft border-line block border-t pt-4"
            >
              <div class="dark:text-fog text-slate mb-2.5 font-mono text-[11px]">
                {postDate && formatDate(postDate)}
              </div>
              <div class="dark:group-hover:text-quartz text-ink group-hover:text-mulberry dark:text-cream font-serif text-[19px] leading-snug font-medium">
                {post.data.title}
              </div>
            </a>
          )
        })
      }
    </div>
  </div>
</div>
