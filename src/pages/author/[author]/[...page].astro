---
import type { Page } from 'astro'
import type { CollectionEntry } from 'astro:content'
import { getCollection, getEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { PAGE_SIZE, getPosts } from '../../../config'
import Base from '../../../layouts/base.astro'
import PageHero from '../../../components/pagehero.astro'
import BlogRoll from '../../../components/blogroll.astro'
import PaginateControl from '../../../components/paginatecontrol.astro'
import coverSVG from '../../../assets/svg/undraw/undraw_short_bio.svg'
import socialImage from '../../../assets/undraw/undraw_short_bio.png'

export async function getStaticPaths() {
  const [authors, posts] = await Promise.all([getCollection('author'), getPosts()])

  return authors.flatMap((author) => {
    const filteredPosts = posts.filter(
      (post) => post.data.author && post.data.author.id === author.id
    )
    const total = filteredPosts.length
    const lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE))

    return Array.from({ length: lastPage }, (_, index) => {
      const currentPageNum = index + 1
      return {
        params:
          currentPageNum === 1
            ? { author: author.id }
            : { author: author.id, page: String(currentPageNum) }
      }
    })
  })
}

const { author, page: pageParam } = Astro.params
const currentPageNum = pageParam ? parseInt(pageParam, 10) : 1

const detail = await getEntry('author', author!)
if (!detail) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

const posts = await getPosts()
const filteredPosts = posts.filter((post) => post.data.author && post.data.author.id === detail.id)

const total = filteredPosts.length
const lastPage = Math.max(1, Math.ceil(total / PAGE_SIZE))

if (currentPageNum < 1 || (currentPageNum > lastPage && lastPage > 0)) {
  return new Response(null, { status: 404, statusText: 'Not found' })
}

const start = (currentPageNum - 1) * PAGE_SIZE
const end = Math.min(start + PAGE_SIZE, total)
const data = filteredPosts.slice(start, end)

const baseUrl = import.meta.env.BASE_URL + `author/${author}/`

const page = {
  data,
  start,
  end: end - 1,
  size: PAGE_SIZE,
  total,
  currentPage: currentPageNum,
  lastPage,
  url: {
    current: currentPageNum === 1 ? baseUrl : `${baseUrl}${currentPageNum}/`,
    prev:
      currentPageNum > 1
        ? currentPageNum === 2
          ? baseUrl
          : `${baseUrl}${currentPageNum - 1}/`
        : undefined,
    next: currentPageNum < lastPage ? `${baseUrl}${currentPageNum + 1}/` : undefined,
    first: baseUrl,
    last: lastPage > 1 ? `${baseUrl}${lastPage}/` : baseUrl
  }
} as Page<CollectionEntry<'blog'>>

const frontmatter: CollectionEntry<'page'>['data'] = {
  title:
    'Author: ' +
    detail.data.title +
    (page.size < page.total ? ' (page ' + page.currentPage + ' of ' + page.lastPage + ')' : ''),
  description: detail.data.description,
  coverSVG: coverSVG,
  socialImage: socialImage
}

const currentPage = Astro.url.pathname.replace(/(\/\d*)?\/$/, '')
---

<Base frontmatter={frontmatter} schema="CollectionPage">
  <header>
    <PageHero
      title={frontmatter.title}
      description={frontmatter.description}
      coverSVG={frontmatter.coverSVG}
      socialImage={frontmatter.socialImage}
    >
      <div class="mt-3 flex items-center gap-2" slot="before">
        <Image
          src={detail.data.image}
          alt={detail.data.title}
          class="h-10 w-10 rounded-full object-cover"
        />
        <span class="text-sm font-semibold text-white">{detail.data.title}</span>
      </div>
      <PaginateControl base={currentPage} page={page} />
    </PageHero>
  </header>
  <div itemprop="mainContentOfPage" class="dark:bg-ink mt-10 bg-gray-100">
    <BlogRoll posts={page.data} />
  </div>
</Base>
