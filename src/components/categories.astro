---
import { getEntries } from 'astro:content'

const { categories } = Astro.props

const cats = await getEntries(categories)

const baseUrl = import.meta.env.BASE_URL
---

{
  categories && (
    <div class="flex flex-row flex-wrap items-start gap-2 pb-2">
      {cats.map((category) => (
        <a
          itemprop="articleSection"
          href={`${baseUrl}category/${encodeURIComponent(category.id)}/`}
          class="dark:border-grape dark:text-grape dark:hover:border-quartz dark:hover:text-quartz border-mulberry text-mulberry hover:border-rose hover:text-rose inline-block border px-2.5 py-1 font-mono text-xs tracking-widest uppercase"
        >
          {(category.data as any).title}
          <span class="sr-only">category</span>
        </a>
      ))}
    </div>
  )
}
