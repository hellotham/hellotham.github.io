---
import type { CollectionEntry } from 'astro:content'
import { SiteMetadata, getPosts } from '../config'
import Base from '../layouts/base.astro'
import Hero from '../components/hero.astro'
import Stats from '../components/stats.astro'
import Features from '../components/features.astro'
import FindOutMore from '../components/findoutmore.astro'
import PartnerStrip from '../components/partnerstrip.astro'
import Achievements from '../components/achievements.astro'
import LatestArticles from '../components/latestarticles.astro'
import CtaBand from '../components/ctaband.astro'
import coverImage from '../assets/svg/rosely/undraw_ideas_flow-light.svg'
import socialImage from '../assets/site/social-card.png'

const frontmatter: CollectionEntry<'page'>['data'] = {
  title: SiteMetadata.title,
  description: SiteMetadata.description,
  coverSVG: coverImage,
  socialImage: socialImage
}

const posts = await getPosts()
---

<Base frontmatter={frontmatter}>
  <Hero />
  <Stats />
  <Features />
  <FindOutMore />
  <PartnerStrip />
  <Achievements />
  <LatestArticles {posts} />
  <CtaBand />
</Base>
