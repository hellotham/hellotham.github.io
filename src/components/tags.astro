---
export interface Props {
  tags?: string[]
}

const { tags } = Astro.props

const baseUrl = import.meta.env.BASE_URL
---

{
  tags && (
    <div class="mt-2 flex flex-row flex-wrap items-start gap-4 lg:gap-2">
      {tags.map((tag) => (
        <a
          href={`${baseUrl}tag/${encodeURIComponent(tag)}/`}
          class="dark:border-ink-soft dark:bg-ink-deep dark:text-fog dark:hover:border-quartz dark:hover:text-quartz border-line bg-cream text-slate hover:border-mulberry hover:text-mulberry inline-block border px-2.5 py-1.5 font-mono text-[11px] lg:py-1"
        >
          #{tag}
        </a>
      ))}
    </div>
  )
}
