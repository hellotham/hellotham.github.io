---
import type { CollectionEntry } from 'astro:content'
import { Image } from 'astro:assets'
import Base from '../layouts/base.astro'
import ChrisPhoto from '../assets/ChrisTham-400.jpg'
import TeamLight from '../assets/svg/rosely/undraw_team_page-light.svg'
import TeamDark from '../assets/svg/rosely/undraw_team_page-dark.svg'
import socialImage from '../assets/social/team_page.png'

const baseUrl = import.meta.env.BASE_URL

const frontmatter: CollectionEntry<'page'>['data'] = {
  title: 'Our Consultants',
  description: 'Showcasing key profiles',
  socialImage: socialImage
}

const skills = [
  'Business and IT strategies',
  'Operating models',
  'Strategic roadmaps',
  'Enterprise architecture',
  'Analytics and Data Science',
  'Business process design'
]

const qualifications = [
  'Master of Applied Finance, Macquarie University',
  'Graduate Diploma in Applied Finance, Finsia',
  'Bachelor of Science (Hons 1st class and University Medal), University of Sydney'
]
---

<Base {frontmatter}>
  <div class="dark:border-ink-soft border-line dark:bg-ink border-b bg-white">
    <div class="mx-auto grid max-w-7xl lg:grid-cols-12">
      <div class="px-6 py-14 sm:px-10 lg:col-span-7 lg:px-14 lg:py-18">
        <p class="dark:text-aqua text-mulberry mb-5 font-mono text-xs tracking-widest uppercase">
          People
        </p>
        <h1
          class="text-ink dark:text-cream font-serif text-4xl leading-none font-medium tracking-tight sm:text-5xl"
        >
          The people who do the work.
        </h1>
        <p class="text-slate dark:text-fog mt-6 max-w-xl text-lg leading-relaxed">
          A boutique firm keeps its promises personal — the consultant who writes the strategy is
          the consultant who delivers it.
        </p>
      </div>
      <div
        class="dark:border-ink-soft dark:bg-plum border-line bg-quartz flex items-center justify-center border-t p-8 sm:p-10 lg:col-span-5 lg:border-t-0 lg:border-l"
      >
        <img
          src={TeamLight.src}
          width={TeamLight.width}
          height={TeamLight.height}
          alt=""
          class="max-h-64 w-full object-contain dark:hidden"
        />
        <img
          src={TeamDark.src}
          width={TeamDark.width}
          height={TeamDark.height}
          alt=""
          class="hidden max-h-64 w-full object-contain dark:block"
        />
      </div>
    </div>
  </div>

  <div class="dark:bg-ink-deep bg-cream">
    <div class="mx-auto max-w-4xl px-6 py-14 sm:px-10 lg:py-16">
      <article class="dark:border-ink-soft dark:bg-ink border-line border bg-white shadow-sm">
        <div
          class="dark:border-ink-soft border-line flex items-baseline justify-between border-b px-7 py-4 sm:px-10"
        >
          <p class="text-mulberry dark:text-grape font-mono text-xs tracking-widest uppercase">
            Profile · Founder &amp; Junior Janitor
          </p>
          <span class="text-fog font-mono text-xs tracking-widest uppercase">Hello Tham</span>
        </div>

        <div class="grid gap-8 p-7 sm:grid-cols-4 sm:p-10">
          <div class="sm:col-span-1">
            <Image
              src={ChrisPhoto}
              alt="Portrait of Chris Tham"
              width={360}
              class="border-line dark:border-ink-soft w-full border"
            />
            <div class="mt-4 flex flex-col gap-1.5">
              <a
                href="https://christham.net"
                rel="noopener noreferrer"
                target="_blank"
                class="dark:text-quartz text-ink hover:text-mulberry font-mono text-xs tracking-widest uppercase dark:hover:text-white"
              >
                christham.net →
              </a>
              <a
                href="https://christham.net/aidou/"
                rel="noopener noreferrer"
                target="_blank"
                class="dark:text-quartz text-ink hover:text-mulberry font-mono text-xs tracking-widest uppercase dark:hover:text-white"
              >
                AI-dō, her book →
              </a>
            </div>
          </div>
          <div class="sm:col-span-3">
            <h2 class="text-ink dark:text-cream font-serif text-3xl font-medium">Chris Tham</h2>
            <p class="text-mulberry dark:text-grape mt-1 text-base">
              Management and strategy consultant
            </p>
            <p class="text-slate dark:text-fog mt-5 text-base leading-relaxed">
              Chris is an experienced management and strategy consultant specialising in Business
              and IT strategies, operating models, strategic roadmaps, enterprise architecture,
              analytics and business process design. She also assists clients in implementing
              recommendations, models and strategies.
            </p>
            <p class="text-slate dark:text-fog mt-4 text-base leading-relaxed">
              Chris has successfully delivered multiple engagements to clients — including companies
              and government organisations — in several countries, focusing on Australia and New
              Zealand, with significant industry experience in financial services,
              telecommunications, engineering, facilities management, asset management, transport,
              retail and medical devices.
            </p>
            <p class="text-slate dark:text-fog mt-4 text-base leading-relaxed">
              Chris has presented at international conferences and published papers in a number of
              technical journals. The results of her work have been profiled in several case studies
              and incorporated into industry frameworks. She also performs interim leadership and
              management roles, and has assisted several organisations in building capability and
              creating high-performance functional teams.
            </p>
          </div>
        </div>

        <div
          class="dark:border-ink-soft border-line grid gap-8 border-t p-7 sm:grid-cols-2 sm:p-10 sm:pt-8"
        >
          <div>
            <p class="text-mulberry dark:text-grape font-mono text-xs tracking-widest uppercase">
              Key skills
            </p>
            <ul class="mt-3 flex flex-col gap-2">
              {
                skills.map((s, i) => (
                  <li class="text-slate dark:text-fog flex gap-3 text-base leading-relaxed">
                    <span class="dark:text-grape text-mulberry font-mono text-xs leading-6">
                      {String(i + 1).padStart(2, '0')}
                    </span>
                    <span>{s}</span>
                  </li>
                ))
              }
            </ul>
          </div>
          <div>
            <p class="text-mulberry dark:text-grape font-mono text-xs tracking-widest uppercase">
              Qualifications
            </p>
            <ul class="mt-3 flex flex-col gap-2">
              {
                qualifications.map((q) => (
                  <li class="text-slate dark:text-fog flex gap-3 text-base leading-relaxed">
                    <span class="dark:text-grape text-mulberry font-mono text-xs leading-6">—</span>
                    <span>{q}</span>
                  </li>
                ))
              }
            </ul>
          </div>
        </div>
      </article>
    </div>
  </div>

  <div class="dark:bg-plum bg-ink">
    <div
      class="mx-auto flex max-w-7xl flex-col items-start justify-between gap-8 px-6 py-14 sm:px-10 lg:flex-row lg:items-center lg:gap-12 lg:px-14"
    >
      <div>
        <h2 class="text-cream font-serif text-3xl font-medium">Work directly with Chris.</h2>
        <p class="text-fog dark:text-plum-mist mt-3 max-w-lg text-base leading-relaxed">
          Every engagement is led personally — no bench, no hand-offs. Tell us what you are working
          through.
        </p>
      </div>
      <a
        href={baseUrl + 'contact'}
        class="bg-quartz text-ink rounded px-9 py-4 text-base font-semibold whitespace-nowrap hover:bg-white"
      >
        Contact us
      </a>
    </div>
  </div>
</Base>
