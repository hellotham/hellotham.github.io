---
import type { CollectionEntry } from 'astro:content'
import { getEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Categories from '../components/categories.astro'
import Tags from '../components/tags.astro'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props

let cat = await getEntry('category', 'general')
if (post.data.categories) {
  cat = await getEntry(post.data.categories[0])
}
const image =
  post.data.coverSVG ||
  post.data.coverImage ||
  (post.data.images && post.data.images[0]) ||
  post.data.socialImage ||
  cat!.data.coverSVG ||
  cat!.data.coverImage
let author = await getEntry('author', 'default')
if (post.data.author) {
  author = await getEntry(post.data.author)
}

const baseUrl = import.meta.env.BASE_URL
const postDate = post.data.publishDate || post.data.pubDate
---

<section class="p-4 md:w-1/2 lg:w-1/3">
  <div
    data-future-mode="show"
    data-publish-date={postDate ? postDate.toISOString() : undefined}
    class="future-hidden border-line dark:border-ink-soft dark:bg-ink-deep h-full overflow-hidden rounded-lg border bg-white p-2 shadow-xl"
  >
    <a href={baseUrl + 'blog/' + post.id}>
      <Image
        src={image}
        alt={post.data.title + ' featured image'}
        format={image.format === 'svg' ? 'svg' : undefined}
        class="bg-cream dark:bg-plum relative h-64 w-full overflow-hidden rounded-lg object-cover object-center group-hover:opacity-75"
      />
      <p itemprop="name" class="sr-only">{post.data.title}</p>
    </a>
    <div class="p-6">
      {post.data.categories && <Categories categories={post.data.categories} />}
      <a itemprop="url" href={baseUrl + 'blog/' + post.id}>
        <h2
          itemprop="name"
          class="text-ink dark:text-cream hover:text-mulberry dark:hover:text-quartz mt-2 font-serif text-xl font-medium"
        >
          {post.data.title}
        </h2>
      </a>
      <div class="flex flex-wrap items-center">
        {
          postDate && (
            <span
              itemprop="datePublished"
              class="border-line text-slate dark:border-ink-soft dark:text-fog mr-3 inline-flex items-center border-r-2 py-1 pr-3 text-xs leading-none"
            >
              <Icon class="mr-1 h-4 w-4" name="ph:calendar-blank" />
              {postDate.toDateString()}
            </span>
          )
        }
        {
          post.data.minutesRead && (
            <span class="border-line text-slate dark:border-ink-soft dark:text-fog mr-3 inline-flex items-center border-r-2 py-1 pr-3 text-xs leading-none">
              <Icon class="mr-1 h-4 w-4" name="ph:clock" />
              {post.data.minutesRead}
            </span>
          )
        }
        <span
          itemprop="author"
          class="text-slate dark:text-fog inline-flex items-center text-xs leading-none"
        >
          <Icon class="mr-1 h-4 w-4" name="ph:user-circle" />
          {author!.data.title}
        </span>
      </div>

      <p itemprop="abstract description" class="text-slate dark:text-fog mt-3 text-sm italic">
        {post.data.description}
      </p>
      <Tags tags={post.data.tags} />
    </div>
  </div>
</section>
