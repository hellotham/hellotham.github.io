---
import type { CollectionEntry } from 'astro:content'

export interface Props {
  base: string
  prev?: CollectionEntry<'blog'> | CollectionEntry<'doc'>
  next?: CollectionEntry<'blog'> | CollectionEntry<'doc'>
}

const { base, prev, next } = Astro.props
---

<dl class="border-line dark:border-ink-soft mt-12 flex border-t pt-6">
  {
    prev && (
      <div class="mr-auto text-left">
        <dt class="font-display text-ink dark:text-cream text-sm font-medium">Prev</dt>
        <dd class="mt-1">
          <a
            class="text-mulberry hover:bg-cream hover:text-rose dark:text-quartz text-base font-semibold"
            href={base + prev.id}
          >
            <span aria-hidden="true">←</span>
            {prev.data.title}
          </a>
        </dd>
      </div>
    )
  }
  {
    next && (
      <div class="ml-auto text-right">
        <dt class="font-display text-ink dark:text-cream text-sm font-medium">Next</dt>
        <dd class="mt-1">
          <a
            class="text-mulberry hover:bg-cream hover:text-rose dark:text-quartz text-base font-semibold"
            href={base + next.id}
          >
            {next.data.title}
            <span aria-hidden="true">→</span>
          </a>
        </dd>
      </div>
    )
  }
</dl>
