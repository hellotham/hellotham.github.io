---
import type { CollectionEntry } from 'astro:content'
import { getEntry } from 'astro:content'
import { Image } from 'astro:assets'
import { Icon } from 'astro-icon/components'
import Categories from '../components/categories.astro'
import Tags from '../components/tags.astro'

export interface Props {
  post: CollectionEntry<'blog'>
}

const { post } = Astro.props

let cat = await getEntry('category', 'general')
if (post.data.categories) {
  cat = await getEntry(post.data.categories[0])
}
const image =
  post.data.coverSVG ||
  post.data.coverImage ||
  (post.data.images && post.data.images[0]) ||
  post.data.socialImage ||
  cat!.data.coverSVG ||
  cat!.data.coverImage
let author = await getEntry('author', 'default')
if (post.data.author) {
  author = await getEntry(post.data.author)
}
const postDate = post.data.publishDate || post.data.pubDate
const isVector = image.format === 'svg'
---

<div class="dark:border-ink-soft border-line dark:bg-ink border-b bg-white">
  <div class="mx-auto grid max-w-7xl lg:grid-cols-12">
    <div class="px-6 py-14 sm:px-10 lg:col-span-7 lg:px-14 lg:py-18">
      {post.data.categories && <Categories categories={post.data.categories} />}
      <h1
        itemprop="name"
        class="text-ink dark:text-cream mt-5 font-serif text-4xl leading-none font-medium tracking-tight sm:text-5xl"
      >
        {post.data.title}
      </h1>
      <p
        itemprop="abstract description"
        class="text-slate dark:text-fog mt-6 text-lg leading-relaxed"
      >
        {post.data.description}
      </p>

      <div
        class="dark:border-ink-soft border-line mt-8 flex flex-wrap items-center gap-x-8 gap-y-3 border-t pt-6"
      >
        <span class="flex items-center gap-2.5">
          <Image
            src={author!.data.image}
            alt=""
            class="border-line dark:border-ink-soft h-9 w-9 rounded-full border object-cover"
          />
          <span class="text-ink dark:text-cream text-sm font-semibold">{author!.data.title}</span>
        </span>
        {
          postDate && (
            <span class="text-slate dark:text-fog flex items-center gap-1.5">
              <Icon class="h-4 w-4" name="ph:calendar-blank" />
              <span class="font-mono text-xs tracking-widest uppercase">
                {postDate.toDateString()}
              </span>
            </span>
          )
        }
        {
          post.data.minutesRead && (
            <span class="text-slate dark:text-fog flex items-center gap-1.5">
              <Icon class="h-4 w-4" name="ph:clock" />
              <span class="font-mono text-xs tracking-widest uppercase">
                {post.data.minutesRead}
              </span>
            </span>
          )
        }
      </div>

      <Tags tags={post.data.tags} />
    </div>

    <div
      class="dark:border-ink-soft dark:bg-plum border-line bg-quartz flex items-center justify-center overflow-hidden border-t p-8 sm:p-10 lg:col-span-5 lg:border-t-0 lg:border-l"
    >
      <Image
        itemprop="image"
        src={image}
        alt=""
        width={640}
        format={isVector ? 'svg' : undefined}
        class={isVector
          ? 'max-h-72 w-full object-contain'
          : 'border-line dark:border-ink-soft max-h-72 w-full border object-cover shadow-sm'}
      />
    </div>
  </div>
</div>
