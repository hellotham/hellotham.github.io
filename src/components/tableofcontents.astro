---
import type { MarkdownHeading } from 'astro'

type Props = {
  headings: MarkdownHeading[]
}

const { headings } = Astro.props as Props
---

<h2 id="table-of-contents-title" class="font-display text-ink dark:text-cream text-sm font-medium">
  On this page
</h2>
<ol class="mt-4 py-1 text-sm">
  {
    headings
      .filter(({ depth }) => depth > 1 && depth < 4)
      .map((heading) => (
        <li
          class={
            heading.depth == 2
              ? 'text-slate dark:text-fog'
              : 'text-slate dark:text-fog mt-2 py-1 pl-5'
          }
        >
          <a class="hover:text-mulberry dark:hover:text-quartz" href={`#${heading.slug}`}>
            {heading.text}
          </a>
        </li>
      ))
  }
</ol>
