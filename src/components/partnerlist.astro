---
import { getCollection } from 'astro:content'
import { Image } from 'astro:assets'
const partners = await getCollection('partner')
---

{
  partners.map((partner) => (
    <div class="mb-4 w-full shrink-0 grow-0 basis-auto">
      <div class="flex items-start">
        <div class="w-64 shrink-0 grow-0">
          <Image
            src={partner.data.image}
            alt={partner.data.title}
            width={256}
            class="object-contain"
          />
        </div>
        <div class="not-prose border-line dark:lg:border-ink-soft ml-4 grow border-l-2 pl-4">
          <p>
            <a
              href={partner.data.link}
              class="text-mulberry hover:text-rose dark:text-quartz text-xl font-bold dark:hover:text-white"
            >
              {partner.data.title}
            </a>
          </p>
          <p class="text-sm italic">{partner.data.status}</p>
          <p class="text-slate mt-2 text-base">{partner.data.description}</p>
        </div>
      </div>
    </div>
  ))
}
