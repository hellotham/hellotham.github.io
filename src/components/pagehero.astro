---
import { Image } from 'astro:assets'
import { DefaultImage } from '../config'

export interface Props {
  title: string
  description?: string
  coverSVG?: ImageMetadata
  coverImage?: ImageMetadata
  socialImage?: ImageMetadata
}

const { title, description, coverSVG, coverImage, socialImage } = Astro.props

const image = coverSVG || coverImage || socialImage || DefaultImage
---

<div class="relative mx-auto h-96 w-full max-w-7xl md:my-4">
  <div class="from-ink absolute bottom-0 left-0 z-10 h-full w-full bg-linear-to-t xl:rounded-lg">
  </div>
  <Image
    itemprop="image"
    src={image}
    alt=""
    format={image.format === 'svg' ? 'svg' : undefined}
    class="absolute top-0 left-0 z-0 h-full w-full object-cover"
  />
  <div class="absolute bottom-0 left-0 z-20 p-4">
    <slot name="before" />
    <h1 itemprop="name" class="font-serif text-4xl leading-tight font-medium text-white">
      {title}
    </h1>
    <p itemprop="abstract description" class="text-quartz text-xl font-medium">
      {description}
    </p>
    <slot />
  </div>
</div>
