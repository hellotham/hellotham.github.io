---
import { Services } from '../config'

const baseUrl = import.meta.env.BASE_URL
---

<div class="dark:bg-ink bg-white">
  <div
    class="mx-auto grid max-w-7xl gap-10 px-6 py-16 sm:px-10 lg:grid-cols-[320px_1fr] lg:gap-16 lg:px-14 lg:py-20"
  >
    <div>
      <p class="dark:text-aqua text-mulberry mb-4 font-mono text-xs tracking-[.2em] uppercase">
        Our services
      </p>
      <h2
        class="text-ink dark:text-cream font-serif text-3xl leading-[1.12] font-medium lg:text-[38px]"
      >
        Vision into reality
      </h2>
      <p class="dark:text-fog text-slate mt-4 text-[15px] leading-relaxed">
        Seven practices. Engaged individually, or as one accountable team from first principle to
        running software.
      </p>
    </div>
    <div>
      {
        Services.map((sv) => (
          <a
            href={baseUrl + 'services#s-' + sv.num}
            class="group dark:border-ink-soft border-line grid grid-cols-[52px_1fr] items-baseline gap-x-3 gap-y-2 border-t py-6 lg:grid-cols-[52px_1fr_320px] lg:gap-6"
          >
            <div class="dark:text-grape text-mulberry font-mono text-[13px]">{sv.num}</div>
            <div class="flex flex-wrap items-baseline gap-2.5">
              <span class="dark:group-hover:text-quartz text-ink group-hover:text-mulberry dark:text-cream font-serif text-2xl font-medium">
                {sv.name}
              </span>
              {sv.isNew && (
                <span class="text-rose border-rose dark:text-aqua border px-1.5 py-0.5 font-mono text-[10px] tracking-[.12em] uppercase dark:border-[#3a4a52]">
                  New
                </span>
              )}
            </div>
            <div class="dark:text-fog text-slate col-start-2 text-sm leading-relaxed lg:col-start-3">
              {sv.desc}
            </div>
          </a>
        ))
      }
    </div>
  </div>
</div>
