---
import { Icon } from 'astro-icon/components'
import { COMMUNITY_INVITE_URL } from '../config'

type Props = {
  editHref: string
}

const { editHref } = Astro.props as Props
const showMoreSection = editHref || COMMUNITY_INVITE_URL
---

{
  showMoreSection && (
    <>
      <h2
        id="more-title"
        class="font-display text-ink dark:text-cream mt-4 space-y-3 text-sm font-medium"
      >
        More
      </h2>
      <ol class="mt-4 flex flex-col space-y-3 text-sm">
        {editHref && (
          <li class="text-slate dark:text-fog flex items-center py-1">
            <Icon name="ph:pencil-simple" class="mr-2 h-6 w-6" />
            <a
              class="hover:text-mulberry dark:hover:text-quartz"
              href={editHref}
              rel="noopener noreferrer"
              target="_blank"
            >
              <span>Edit this page</span>
            </a>
          </li>
        )}
        {COMMUNITY_INVITE_URL && (
          <li class="text-slate dark:text-fog flex items-center py-1">
            <Icon name="ph:chat-text" class="mr-2 h-6 w-6" />
            <a
              class="hover:text-mulberry dark:hover:text-quartz"
              href={COMMUNITY_INVITE_URL}
              target="_blank"
            >
              <span>Join our community</span>
            </a>
          </li>
        )}
      </ol>
    </>
  )
}
