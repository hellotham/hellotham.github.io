---
// import { ViewTransitions } from 'astro:transitions'
import type { CollectionEntry } from 'astro:content'
import { Font } from 'astro:assets'
import SEO from '../components/seo.astro'
import Header from '../components/header.astro'
import Footer from '../components/footer.astro'
import Gallery from '../components/gallery.astro'
import MarkmapLoader from '../components/markmap.astro'
import { SiteMetadata } from '../config'

export interface Props {
  frontmatter: CollectionEntry<'blog'>['data'] | CollectionEntry<'page'>['data']
  schema?: string
}

const { frontmatter, schema = 'WebPage' } = Astro.props
const fm = frontmatter as any

const baseUrl = import.meta.env.BASE_URL

import '../styles/global.css'
---

<!doctype html>
<html lang="en" itemscope itemtype={`https://schema.org/${schema}`} data-base-url={baseUrl}>
  <head>
    <meta charset="UTF-8" />
    <meta
      http-equiv="Content-Security-Policy"
      content="default-src 'self'; script-src 'self' 'unsafe-eval' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.plantuml.com https://*.tile.openstreetmap.org; font-src 'self'; connect-src 'self';"
    />
    <meta name="viewport" content="width=device-width" />
    <link rel="icon" href={`${baseUrl}favicon.ico`} sizes="any" />
    <link rel="icon" href={`${baseUrl}favicon.svg`} type="image/svg+xml" />
    <link rel="apple-touch-icon" href={`${baseUrl}apple-touch-icon.png`} />
    <link rel="manifest" href={`${baseUrl}site.webmanifest`} />
    <link rel="sitemap" href={`${Astro.site}sitemap-index.xml`} />
    <link
      rel="alternate"
      type="application/rss+xml"
      title={SiteMetadata.title}
      href={`${Astro.site}rss.xml`}
    />
    <meta name="generator" content={Astro.generator} />
    {
      /* Preload only the upright latin faces. latin-ext and italic files are
        large and the browser fetches them on demand, when a glyph needs them. */
    }
    <Font cssVariable="--font-noto-sans" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--font-noto-serif" preload={[{ subset: 'latin', style: 'normal' }]} />
    <Font cssVariable="--font-noto-sans-mono" />
    <SEO frontmatter={frontmatter} />
    <script is:inline>
      const setDarkMode = () => {
        if (
          localStorage.theme === 'dark' ||
          (!('theme' in localStorage) && window.matchMedia('(prefers-color-scheme: dark)').matches)
        ) {
          document.documentElement.classList.add('dark')
        } else {
          document.documentElement.classList.remove('dark')
        }
      }
      setDarkMode() //initial navigation
      document.addEventListener('astro:after-swap', setDarkMode) // Runs on view transitions navigation

      const applyFutureUnlock = () => {
        const now = Date.now()
        document.querySelectorAll('[data-publish-date]').forEach((el) => {
          const publishDateAttr = el.getAttribute('data-publish-date')
          if (!publishDateAttr) return
          const publishTime = Date.parse(publishDateAttr)
          if (Number.isNaN(publishTime)) return

          const isReleased = publishTime <= now
          const mode = el.getAttribute('data-future-mode') || 'show'

          if (mode === 'show') {
            if (isReleased) {
              el.classList.remove('future-hidden')
            } else {
              el.classList.add('future-hidden')
            }
            return
          }

          if (mode === 'lock') {
            const lockPane = el.querySelector('[data-future-lock]')
            const contentPane = el.querySelector('[data-future-content]')
            if (isReleased) {
              lockPane?.classList.add('hidden')
              contentPane?.classList.remove('hidden')
            } else {
              lockPane?.classList.remove('hidden')
              contentPane?.classList.add('hidden')
            }
          }
        })

        document.querySelectorAll('[data-future-list]').forEach((list) => {
          const cards = list.querySelectorAll('[data-future-mode="show"][data-publish-date]')
          const visibleCards = Array.from(cards).filter(
            (card) => !card.classList.contains('future-hidden')
          )
          const emptyBanner = list.querySelector('[data-future-empty]')
          if (!emptyBanner) return

          if (cards.length > 0 && visibleCards.length === 0) {
            emptyBanner.classList.remove('hidden')
          } else {
            emptyBanner.classList.add('hidden')
          }
        })
      }

      if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', applyFutureUnlock)
      } else {
        applyFutureUnlock()
      }
      document.addEventListener('astro:after-swap', applyFutureUnlock)
    </script>
    <style is:inline>
      [x-cloak] {
        display: none !important;
      }
      .markmap > svg {
        width: 100%;
        height: 400px;
      }
      .future-hidden {
        display: none !important;
      }
    </style>
    {fm.extra?.includes('math') && <style>@import "katex/dist/katex.min.css";</style>}
    <slot name="in-head" />
  </head>
  <body class="dark:bg-ink bg-white">
    <a
      href="#main"
      class="bg-ink text-cream fixed -top-20 left-4 z-60 rounded px-4 py-2 focus:top-4"
    >
      Skip to content
    </a>
    <Header />
    <main id="main">
      <slot />
      {fm.gallery && <Gallery folder={fm.gallery} />}
      <slot name="before-footer" />
    </main>
    <Footer />
    {fm.extra?.includes('markmap') && <MarkmapLoader />}
  </body>
</html>
