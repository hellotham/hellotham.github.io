---
import type { CollectionEntry } from 'astro:content'
import Base from '../layouts/base.astro'
import { Services } from '../config'
import FeaturesOverviewLight from '../assets/svg/rosely/undraw_features_overview-light.svg'
import FeaturesOverviewDark from '../assets/svg/rosely/undraw_features_overview-dark.svg'
import socialImage from '../assets/social/features_overview.png'

const baseUrl = import.meta.env.BASE_URL

const frontmatter: CollectionEntry<'page'>['data'] = {
  title: 'Services',
  description: 'Focus on business and IT strategy',
  socialImage: socialImage
}
---

<Base {frontmatter}>
  <div class="dark:border-ink-soft border-line dark:bg-ink border-b bg-white">
    <div class="mx-auto grid max-w-7xl lg:grid-cols-12">
      <div class="px-6 py-14 sm:px-10 lg:col-span-7 lg:px-14 lg:py-19">
        <p class="dark:text-aqua text-mulberry mb-5 font-mono text-xs tracking-widest uppercase">
          Services
        </p>
        <h1
          class="text-ink dark:text-cream font-serif text-4xl leading-none font-medium tracking-tight sm:text-5xl"
        >
          Focus on business and IT strategy.
        </h1>
        <p class="text-slate dark:text-fog mt-6 max-w-xl text-lg leading-relaxed">
          Our consultants have successfully delivered multiple engagements to companies and
          government organisations in several countries, focusing on Australia and New Zealand.
        </p>
      </div>
      <div
        class="dark:border-ink-soft dark:bg-plum border-line bg-quartz flex items-center justify-center border-t p-8 sm:p-10 lg:col-span-5 lg:border-t-0 lg:border-l"
      >
        <img
          src={FeaturesOverviewLight.src}
          width={FeaturesOverviewLight.width}
          height={FeaturesOverviewLight.height}
          alt=""
          class="max-h-64 w-full object-contain dark:hidden"
        />
        <img
          src={FeaturesOverviewDark.src}
          width={FeaturesOverviewDark.width}
          height={FeaturesOverviewDark.height}
          alt=""
          class="hidden max-h-64 w-full object-contain dark:block"
        />
      </div>
    </div>
  </div>

  <div class="dark:bg-ink bg-white">
    <div class="mx-auto max-w-7xl">
      {
        Services.map((sv) => (
          <div
            id={'s-' + sv.num}
            class="dark:border-ink-soft border-line grid scroll-mt-24 gap-x-12 gap-y-4 border-b px-6 py-10 sm:px-10 lg:grid-cols-12 lg:px-14"
          >
            <div class="dark:text-grape text-mulberry font-mono text-sm lg:col-span-2">
              {sv.num}
            </div>
            <div class="flex flex-col gap-2.5 lg:col-span-5">
              <div class="flex flex-wrap items-baseline gap-2.5">
                <h3 class="text-ink dark:text-cream font-serif text-2xl font-medium lg:text-3xl">
                  {sv.name}
                </h3>
                {sv.isNew && (
                  <span class="text-rose border-rose dark:text-aqua border px-1.5 py-0.5 font-mono text-xs tracking-widest uppercase dark:border-slate-600">
                    New
                  </span>
                )}
              </div>
              <span class="dark:text-fog text-slate font-mono text-xs tracking-widest uppercase">
                {sv.tag}
              </span>
              {sv.href && (
                <a
                  href={baseUrl + sv.href}
                  class="dark:text-quartz text-ink hover:text-mulberry mt-1 font-mono text-xs tracking-widest uppercase dark:hover:text-white"
                >
                  Learn more →
                </a>
              )}
            </div>
            <p class="dark:text-fog text-slate text-base leading-relaxed lg:col-span-5">
              {sv.long}
            </p>
          </div>
        ))
      }
    </div>
  </div>

  <div class="dark:bg-ink-deep bg-cream">
    <div
      class="mx-auto grid max-w-7xl gap-10 px-6 py-14 sm:px-10 lg:grid-cols-2 lg:gap-16 lg:px-14 lg:py-15"
    >
      <div>
        <h3 class="text-ink dark:text-cream mb-3.5 font-serif text-2xl font-medium">
          NSW Government ICT Services Scheme SCM0020
        </h3>
        <p class="dark:text-fog text-slate text-base leading-relaxed">
          Prequalified supplier, listed for Enterprise &amp; Business Architecture, Information
          Architecture, Solution Architecture, Benchmarking, ICT Strategy, Efficiency &amp;
          Optimisation, Project/Program/Portfolio Management, Business Analysis, Information
          Management Services and Professional Services.
        </p>
      </div>
      <div>
        <h3 class="text-ink dark:text-cream mb-3.5 font-serif text-2xl font-medium">
          APQC Process Classification Framework
        </h3>
        <p class="dark:text-fog text-slate text-base leading-relaxed">
          Services map to APQC v7.0.2 categories 1.0 Develop Vision and Strategy, 8.1–8.7 Manage the
          business of information technology, and 13.1–13.6 Manage business processes and
          performance.
        </p>
      </div>
    </div>
  </div>
</Base>
