---
import { getCollection } from 'astro:content'
import { Icon } from 'astro-icon/components'
import { Logo } from '../config'

const social = await getCollection('social')

const baseUrl = import.meta.env.BASE_URL
---

<footer class="bg-ink-deep dark:bg-ink-black">
  <div
    class="text-fog mx-auto flex max-w-7xl flex-col gap-4 px-6 py-7 text-sm sm:px-10 lg:flex-row lg:items-center lg:justify-between lg:px-14"
  >
    <span class="flex items-center gap-3">
      <a href={baseUrl} class="flex shrink-0 items-center">
        <img
          src={Logo.src}
          width={Logo.width}
          height={Logo.height}
          alt="Hello Tham logo"
          class="h-6 w-6"
          loading="lazy"
        />
        <span class="sr-only">Home</span>
      </a>
      <span>© {new Date().getFullYear()} Hello Tham Pty Ltd · ABN 44 617 279 115 · Sydney NSW</span>
    </span>
    <span class="flex flex-wrap items-center gap-x-5 gap-y-2">
      <a
        href={baseUrl + 'contact'}
        class="text-quartz dark:text-fog dark:hover:text-quartz hover:text-white">Contact</a
      >
      <a
        href={baseUrl + 'privacy'}
        class="text-quartz dark:text-fog dark:hover:text-quartz hover:text-white">Privacy</a
      >
      <a
        href={baseUrl + 'rss.xml'}
        class="text-quartz dark:text-fog dark:hover:text-quartz hover:text-white"
        rel="noopener noreferrer"
        target="_blank">RSS</a
      >
      <a
        href={baseUrl + 'sitemap-index.xml'}
        class="text-quartz dark:text-fog dark:hover:text-quartz hover:text-white"
        rel="noopener noreferrer"
        target="_blank">Sitemap</a
      >
      <span class="flex items-center gap-3">
        {
          social.map((s) =>
            s.data.link ? (
              <a
                href={s.data.link}
                class="text-fog hover:text-quartz"
                rel="noopener noreferrer"
                target="_blank"
              >
                <Icon name={'bi:' + s.data.icon} class="h-4 w-4" />
                <span class="sr-only">{s.data.name}</span>
              </a>
            ) : (
              ''
            )
          )
        }
      </span>
    </span>
  </div>
</footer>
