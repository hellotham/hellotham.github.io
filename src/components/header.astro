---
import { Icon } from 'astro-icon/components'
import { NavigationLinks } from '../config'
import Search from '../components/search.astro'
import Theme from '../components/theme.astro'
import { Logo } from '../config'

const baseUrl = import.meta.env.BASE_URL
---

<div class="relative h-20 w-full">
  <nav class="dark:bg-ink-deep">
    <div
      class="dark:border-ink-soft dark:bg-ink-deep border-ink fixed z-50 mx-auto w-full border-b bg-white px-2 sm:px-6 lg:px-8"
    >
      <div class="relative flex h-20 items-center justify-between">
        <div class="absolute inset-y-0 left-0 flex items-center lg:hidden">
          <!-- Mobile menu button-->
          <button
            type="button"
            id="mobile-menu-button"
            class="dark:text-fog dark:hover:text-quartz text-ink hover:bg-cream hover:text-mulberry focus:ring-mulberry dark:hover:bg-ink inline-flex items-center justify-center rounded-md p-2 focus:ring-2 focus:outline-none focus:ring-inset"
            aria-controls="mobile-menu"
            aria-expanded="false"
          >
            <span class="sr-only">Open main menu</span>
            <Icon
              id="mobile-menu-icon-bars"
              class="block h-6 w-6"
              aria-hidden="true"
              name="heroicons:bars-3"
            />
            <Icon
              id="mobile-menu-icon-x"
              class="hidden h-6 w-6"
              aria-hidden="true"
              name="heroicons:x-mark"
            />
          </button>
        </div>
        <div class="flex flex-1 items-center justify-start pl-12 lg:items-stretch lg:pl-0">
          <a class="flex shrink-0 items-center" href={baseUrl}>
            <img class="block h-8 w-8" src={Logo.src} alt="Hello Tham logo" />
            <span class="sr-only">Home</span>
          </a>
          <div class="hidden lg:mx-6 lg:block">
            <div class="flex items-center gap-6 self-stretch lg:h-full">
              {
                NavigationLinks.map((item) => (
                  <a
                    href={baseUrl + item.href}
                    class={
                      (item.href.length > 0 && Astro.url.toString().includes(item.href)
                        ? 'text-mulberry dark:text-quartz'
                        : 'dark:text-fog dark:hover:text-quartz text-ink hover:text-mulberry') +
                      ' text-[15px] font-medium'
                    }
                    aria-current={
                      item.href.length > 0 && Astro.url.toString().includes(item.href)
                        ? 'page'
                        : undefined
                    }
                  >
                    {item.name}
                  </a>
                ))
              }
            </div>
          </div>
        </div>
        <div
          class="absolute inset-y-0 right-0 flex items-center pr-2 sm:static sm:inset-auto sm:ml-6 sm:pr-0"
        >
          <Search />
          <Theme />
        </div>
      </div>
    </div>

    <!-- Mobile menu, show/hide based on menu state. -->
    <div class="absolute inset-x-0 top-20 z-50 hidden" id="mobile-menu">
      <div
        class="dark:border-ink-soft dark:bg-ink-deep border-line flex flex-wrap justify-center gap-x-4 gap-y-1 border-b bg-white px-4 py-3 font-medium"
      >
        {
          NavigationLinks.map((item) => (
            <a
              href={baseUrl + item.href}
              class:list={[
                item.href.length > 0 && Astro.url.toString().includes(item.href)
                  ? 'text-mulberry dark:text-quartz'
                  : 'dark:text-fog dark:hover:text-quartz text-ink hover:text-mulberry',
                'px-2 py-1'
              ]}
              aria-current={
                item.href.length > 0 && Astro.url.toString().includes(item.href)
                  ? 'page'
                  : undefined
              }
            >
              {item.name}
            </a>
          ))
        }
      </div>
    </div>
  </nav>
</div>

<script>
  function setupMobileMenu() {
    const btn = document.getElementById('mobile-menu-button')
    const menu = document.getElementById('mobile-menu')
    const iconBars = document.getElementById('mobile-menu-icon-bars')
    const iconX = document.getElementById('mobile-menu-icon-x')

    if (btn && menu && iconBars && iconX) {
      btn.addEventListener('click', () => {
        const isExpanded = btn.getAttribute('aria-expanded') === 'true'
        btn.setAttribute('aria-expanded', String(!isExpanded))

        if (isExpanded) {
          menu.classList.add('hidden')
          iconBars.classList.remove('hidden')
          iconBars.classList.add('block')
          iconX.classList.remove('block')
          iconX.classList.add('hidden')
        } else {
          menu.classList.remove('hidden')
          iconBars.classList.remove('block')
          iconBars.classList.add('hidden')
          iconX.classList.remove('hidden')
          iconX.classList.add('block')
        }
      })
    }
  }

  setupMobileMenu()
  document.addEventListener('astro:after-swap', setupMobileMenu)
</script>
